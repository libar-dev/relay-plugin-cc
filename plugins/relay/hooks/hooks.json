{
  "description": "Session exports, the optional stop-time review gate, the relay:job relay hook, which carries the relay's prompt, messages and report, and a module whose session.send hook wakes a relay's wait when a message is queued for it.",
  "modules": [
    "./mod/register.js"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session-lifecycle.mjs\" SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/stop-review-gate.mjs\"",
            "timeout": 900
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|SubagentHandback|StructuredOutput",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/relay-guard.mjs\"",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^relay:job$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/relay-guard.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
